# Punkto – Hostinger/Apache
AddType application/manifest+json .webmanifest
AddType application/javascript .js
AddType image/svg+xml .svg
# WASM korrekt ausliefern, damit Tesseract-OCR die .wasm direkt per
# WebAssembly.instantiateStreaming laedt (statt ueber den langsameren
# ArrayBuffer-Fallback bei falschem text/plain-MIME).
AddType application/wasm .wasm
AddDefaultCharset UTF-8
# Was nie ausgeliefert werden darf (falls es doch einmal hochgeladen wird):
# Betreiber-Schluessel, Skripte, Logs, Notizen, Backups.
<FilesMatch "(\.local\.txt|\.ps1|\.py|\.sh|\.log|\.md|\.bak|\.sql|\.env|~)$">
  Require all denied
</FilesMatch>
<IfModule mod_headers.c>
  # Grundhaertung (kein CSP: die App nutzt Inline-Skripte; kommt ggf. spaeter als Report-Only)
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  # Kamera fuer Barcode/Foto-Scan nur fuer die eigene Seite; Mikrofon/Standort aus.
  Header always set Permissions-Policy "camera=(self), microphone=(), geolocation=(), payment=()"
  # HSTS (Browser werten es nur ueber HTTPS aus; die Seite laeuft ausschliesslich per HTTPS)
  Header always set Strict-Transport-Security "max-age=15552000"
</IfModule>
<IfModule mod_headers.c>
  # Reihenfolge wichtig: bei mehreren Treffern gewinnt die letzte Regel.
  <FilesMatch "\.(css|js|png|svg|woff2?)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Service Worker, Manifest und Deploy-Marker immer frisch holen (schlaegt die .js-Regel oben)
  <FilesMatch "^(sw\.js|manifest\.webmanifest|deploy-version\.txt)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
# JSON-Lebensmitteldatenbank ausliefern, aber nur diese eine Datei im Datenordner
<IfModule mod_headers.c>
  <FilesMatch "\.json$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
</IfModule>
